class Solution(object):
    def generate(self, numRows):
        """
        :type numRows: int
        :rtype: List[List[int]]
        """
        a=[[1]]
        for i in range(1,numRows):
            b=[1]
            for j in range(1,i):
                b.append(a[i-1][j]+a[i-1][j-1])
            b.append(1)
            a.append(b)
        return a
