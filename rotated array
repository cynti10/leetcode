def bin(arr, l, h, k):
    if l <= h:
        m = (l + h) // 2
        if arr[m] == k:
            return m
        elif arr[m] < k:
            return bin(arr, m + 1, h, k)
        else:
            return bin(arr, l, m - 1, k)
    return -1

def rot(arr):
    l, h = 0, len(arr) - 1
    while l < h:
        m = (l + h) // 2
        if arr[m] > arr[m + 1]:
            return m + 1
        elif arr[l] >= arr[m]:
            h = m
        else:
            l = m + 1
    return 0 if arr else -1
inp = input()
if inp.startswith('[') and inp.endswith(']'):
    el = inp[1:-1].split(',')
arr = [int(e.strip()) for e in el]
r = rot(arr)
k = int(input())
n = len(arr)
if r == 0:
    l, h = 0, n - 1
else:
    if arr[n - 1] < k:
        l, h = 0, r - 1
    else:
        l, h = r, n - 1
print(bin(arr, l, h, k)
